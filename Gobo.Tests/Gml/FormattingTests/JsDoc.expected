#region jsDoc
/// @param {String} initial_state		Initial state
#endregion
function SnowState(_initState, _execEnter = true) constructor {
	#region jsDoc
	/// @param {String} event
	/// @returns {SnowState} self
	/// @self SnowState
	#endregion
	__add_event_method = function(_event) {
		return self;
	};

	#region jsDoc
	/// @function plain_method
	/// @description <desc>
	/// @param {Any} _a			<desc>
	/// @param {Any} [_b]		<desc>
	/// @returns {Any}
	/// @self SnowState
	#endregion
	static plain_method = function(_a, _b = 1) {
		return _a + _b;
	};

	value = 1;
}

