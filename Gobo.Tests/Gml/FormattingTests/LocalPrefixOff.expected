#region jsDoc
/// @function scr_jab
/// @description <desc>
/// @returns {Any}
#endregion
function scr_jab() {
	var run = true;
	var _phase = attack_phase;
	var jabbuffer = 8;
	if (run && check_jump()) {
		run = false;
	}
	other.run = 1;
	var obj = {run, phase: _phase};
	return jabbuffer;
}

#region jsDoc
/// @function outer
/// @description <desc>
/// @param {Any} alpha		<desc>
/// @param {Any} _beta		<desc>
/// @returns {Any}
#endregion
function outer(alpha, _beta) {
	var value = alpha + _beta;

	#region jsDoc
	/// @function inner
	/// @description <desc>
	/// @param {Any} alpha		<desc>
	/// @returns {Any}
	#endregion
	var inner = function(alpha) {
		return alpha;
	};

	return inner(value);
}

#region jsDoc
/// @function taken
/// @description <desc>
/// @param {Any} count		<desc>
/// @returns {Any}
#endregion
function taken(count) {
	var _count = 1;
	return count + _count;
}

#region jsDoc
/// @function statics
/// @description <desc>
#endregion
function statics() constructor {
	static shared = 0;

	#region jsDoc
	/// @function get_shared
	/// @description <desc>
	/// @returns {Any}
	/// @self statics
	#endregion
	static get_shared = function() {
		return shared;
	};
}
